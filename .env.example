# Stripe configuration — copy this file to .env.local and fill in real values.
# Never commit real keys. .env.local is gitignored.

# Publishable key (safe to expose to the browser)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx

# Secret key (server-only — never expose to the client)
STRIPE_SECRET_KEY=sk_test_xxx

# Webhook signing secret for /api/webhook signature verification
# Local dev: run `stripe listen --forward-to localhost:3000/api/webhook`
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Resend — order confirmation emails (https://resend.com/api-keys)
RESEND_API_KEY=re_xxx
# Verified sender address. onboarding@resend.dev works for testing without a domain.
RESEND_FROM="Wellness Shop <onboarding@resend.dev>"
# Merchant inbox that receives a copy of every order (for your records).
ORDER_NOTIFICATION_EMAIL=globalsupply600@gmail.com

# Public site URL — used for SEO metadata, sitemap.xml, robots.txt and absolute OG URLs.
NEXT_PUBLIC_SITE_URL=https://globalsupply600.com

# Supabase — order persistence (server-only; used by the Stripe webhook).
# Dashboard → Project Settings → Data API / API keys.
# Run supabase/schema.sql once to create the orders table.
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=service_role_key_xxx
